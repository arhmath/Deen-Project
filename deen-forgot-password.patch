+/**
+ * Mock alur reset password (HANYA untuk mode demo).
+ * Meniru aturan backend: token acak, sekali pakai, kedaluwarsa 30 menit.
+ * Mock tidak mengirim email; tautan reset dikembalikan di respons supaya bisa didemokan.
+ */
+const TOKENS_KEY = "deen.mock.resets.v1";
+const OVERRIDES_KEY = "deen.mock.pwd.v1";
+const TTL_MS = 30 * 60 * 1000;
+
+interface ResetToken {
+  token: string;
+  userId: string;
+  expiresAt: number;
+  used: boolean;
+}
+
+function read<T>(key: string, fallback: T): T {
+  try {
+    const raw = localStorage.getItem(key);
+    return raw ? (JSON.parse(raw) as T) : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function write(key: string, value: unknown) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value));
+  } catch {
+    /* storage diblokir — mock reset tidak tersimpan */
+  }
+}
+
+function randomToken(): string {
+  const bytes = new Uint8Array(24);
+  crypto.getRandomValues(bytes);
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+export function issueResetToken(userId: string): string {
+  const now = Date.now();
+  // buang token lama milik user ini dan token yang sudah kedaluwarsa
+  const list = read<ResetToken[]>(TOKENS_KEY, []).filter((t) => t.userId !== userId && t.expiresAt > now);
+  const token = randomToken();
+  list.push({ token, userId, expiresAt: now + TTL_MS, used: false });
+  write(TOKENS_KEY, list);
+  return token;
+}
+
+/** Mengembalikan userId jika token valid, lalu menandainya terpakai (sekali pakai). */
+export function consumeResetToken(token: string): string | null {
+  const list = read<ResetToken[]>(TOKENS_KEY, []);
+  const t = list.find((x) => x.token === token);
+  if (!t || t.used || t.expiresAt <= Date.now()) return null;
+  t.used = true;
+  write(TOKENS_KEY, list);
+  return t.userId;
+}
+
+/** Password baru untuk akun demo bawaan (akun hasil register disimpan langsung di daftar akunnya). */
+export function getPasswordOverride(userId: string): string | undefined {
+  return read<Record<string, string>>(OVERRIDES_KEY, {})[userId];
+}
+
+export function setPasswordOverride(userId: string, password: string) {
+  const map = read<Record<string, string>>(OVERRIDES_KEY, {});
+  map[userId] = password;
+  write(OVERRIDES_KEY, map);
+}
