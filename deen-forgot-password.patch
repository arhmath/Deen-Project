+
+/** Pesan ramah untuk error umum di alur lupa/reset password. */
+function friendlyResetError(err: unknown): Error {
+  if (err instanceof ApiError) {
+    if (err.status === 429) return new Error("Terlalu sering mencoba. Tunggu beberapa menit, lalu coba lagi ya.");
+    if (err.status === 404 || err.status === 501) {
+      return new Error("Fitur reset password belum aktif di server. Hubungi gurumu atau admin untuk dibantu.");
+    }
+    return new Error(err.message);
+  }
+  return err instanceof Error ? err : new Error("Terjadi kesalahan. Coba lagi ya.");
+}
+
+export function useForgotPassword() {
+  return useMutation({
+    mutationFn: async (payload: ForgotPasswordRequest) => {
+      try {
+        return await authService.forgotPassword(payload);
+      } catch (err) {
+        throw friendlyResetError(err);
+      }
+    },
+  });
+}
+
+export function useResetPassword() {
+  return useMutation({
+    mutationFn: async (payload: ResetPasswordRequest) => {
+      try {
+        return await authService.resetPassword(payload);
+      } catch (err) {
+        throw friendlyResetError(err);
+      }
+    },
+  });
+}
