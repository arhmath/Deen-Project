+import { Link, useNavigate, useSearchParams } from "react-router-dom";
+import { AuthLayout } from "../components/layout/AuthLayout";
+import { ButtonLink } from "../components/ui/ButtonLink";
+import { ResetPasswordForm } from "../features/auth/ResetPasswordForm";
+import { useResetPassword } from "../features/auth/useAuth";
+import type { ResetPasswordFormValues } from "../lib/validation/authSchemas";
+import heroLogin from "../assets/herologin.jpg";
+
+const layoutProps = {
+  imageSrc: heroLogin,
+  imageAlt: "Santri Bermain dan Belajar Bersama",
+  imageHeadline: "Sedikit lagi, lalu lanjut petualanganmu!",
+  imageCaption: "Buat password baru yang mudah kamu ingat tapi sulit ditebak orang lain.",
+  imagePosition: "right" as const,
+};
+
+export function ResetPasswordPage() {
+  const [params] = useSearchParams();
+  const token = params.get("token") ?? "";
+  const navigate = useNavigate();
+  const reset = useResetPassword();
+
+  // Tanpa token → tautan rusak/terpotong
+  if (!token) {
+    return (
+      <AuthLayout
+        title="Tautan tidak valid"
+        subtitle="Tautan reset password ini tidak lengkap. Minta tautan baru, ya."
+        footer={
+          <Link to="/login" className="font-bold text-brand-purple hover:underline">
+            Kembali ke halaman masuk
+          </Link>
+        }
+        {...layoutProps}
+      >
+        <ButtonLink to="/forgot-password" className="w-full">
+          Minta tautan baru
+        </ButtonLink>
+      </AuthLayout>
+    );
+  }
+
+  async function handleSubmit(values: ResetPasswordFormValues) {
+    await reset.mutateAsync({ token, password: values.password });
+    navigate("/login", {
+      replace: true,
+      state: { notice: "Password berhasil diubah. Silakan masuk dengan password barumu." },
+    });
+  }
+
+  return (
+    <AuthLayout
+      title="Buat password baru"
+      subtitle="Pilih password baru untuk akunmu."
+      footer={
+        <Link to="/login" className="font-bold text-brand-purple hover:underline">
+          Kembali ke halaman masuk
+        </Link>
+      }
+      {...layoutProps}
+    >
+      <ResetPasswordForm onSubmit={handleSubmit} />
+      {reset.isError && (
+        <p className="mt-4 text-center text-sm text-brand-ink/70">
+          Tautan bermasalah?{" "}
+          <Link to="/forgot-password" className="font-bold text-brand-purple hover:underline">
+            Minta tautan reset baru
+          </Link>
+        </p>
+      )}
+    </AuthLayout>
+  );
+}
+
+export default ResetPasswordPage;
