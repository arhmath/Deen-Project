--- /dev/null
+++ b/src/pages/ForgotPasswordPage.tsx
@@ -0,0 +1,148 @@
+import { useEffect, useRef, useState } from "react";
+import { Link, Navigate } from "react-router-dom";
+import { AuthLayout } from "../components/layout/AuthLayout";
+import { Button } from "../components/ui/Button";
+import { MailIcon } from "../components/ui/FormIcons";
+import { ForgotPasswordForm } from "../features/auth/ForgotPasswordForm";
+import { homePathFor, useForgotPassword, useMe } from "../features/auth/useAuth";
+import type { ForgotPasswordFormValues } from "../lib/validation/authSchemas";
+import { USE_MOCK } from "../services/api";
+import heroLogin from "../assets/herologin.jpg";
+
+const RESEND_SECONDS = 60;
+
+interface Sent {
+  identifier: string;
+  message: string;
+  devResetPath?: string;
+}
+
+export function ForgotPasswordPage() {
+  const me = useMe();
+  const forgot = useForgotPassword();
+  const [sent, setSent] = useState<Sent | null>(null);
+  const [cooldown, setCooldown] = useState(0);
+  const [resendError, setResendError] = useState<string | null>(null);
+  const headingRef = useRef<HTMLHeadingElement>(null);
+  const isSent = sent !== null;
+
+  // hitung mundur sebelum boleh kirim ulang
+  useEffect(() => {
+    if (cooldown <= 0) return;
+    const t = setTimeout(() => setCooldown((c) => c - 1), 1000);
+    return () => clearTimeout(t);
+  }, [cooldown]);
+
+  // pindahkan fokus ke judul konfirmasi supaya pengguna pembaca layar tahu hasilnya
+  useEffect(() => {
+    if (isSent) headingRef.current?.focus();
+  }, [isSent]);
+
+  // Sudah punya sesi valid → tidak perlu reset password
+  if (me.data) return <Navigate to={homePathFor(me.data.role)} replace />;
+
+  async function handleSubmit(values: ForgotPasswordFormValues) {
+    const res = await forgot.mutateAsync({ identifier: values.identifier });
+    setSent({ identifier: values.identifier, message: res.message, devResetPath: res.devResetPath });
+    setResendError(null);
+    setCooldown(RESEND_SECONDS);
+  }
+
+  async function resend() {
+    if (!sent || cooldown > 0 || forgot.isPending) return;
+    setResendError(null);
+    try {
+      const res = await forgot.mutateAsync({ identifier: sent.identifier });
+      setSent({ ...sent, message: res.message, devResetPath: res.devResetPath });
+      setCooldown(RESEND_SECONDS);
+    } catch (err) {
+      setResendError(err instanceof Error ? err.message : "Belum berhasil mengirim ulang. Coba lagi ya.");
+    }
+  }
+
+  return (
+    <AuthLayout
+      title="Lupa password?"
+      subtitle={
+        isSent
+          ? "Ikuti petunjuk di email untuk membuat password baru."
+          : "Tenang, masukkan username atau email-mu dan kami kirim tautan untuk membuat password baru."
+      }
+      imageSrc={heroLogin}
+      imageAlt="Santri Bermain dan Belajar Bersama"
+      imageHeadline="Lupa itu manusiawi. Yang penting lanjut belajar lagi!"
+      imageCaption="Reset password dulu, streak dan XP-mu tetap aman menunggumu."
+      imagePosition="right"
+      footer={
+        <p>
+          Sudah ingat?{" "}
+          <Link to="/login" className="font-bold text-brand-purple hover:underline">
+            Kembali ke halaman masuk
+          </Link>
+        </p>
+      }
+    >
+      {sent ? (
+        <div className="flex flex-col gap-5">
+          <div className="flex flex-col items-center gap-3 rounded-3xl border-2 border-brand-ink/10 bg-white p-6 text-center">
+            <span className="grid h-14 w-14 place-items-center rounded-full bg-brand-purple/10 text-brand-purple" aria-hidden="true">
+              <MailIcon className="h-7 w-7" />
+            </span>
+            <h2
+              ref={headingRef}
+              tabIndex={-1}
+              className="font-display text-xl font-extrabold text-brand-ink outline-none"
+            >
+              Cek emailmu
+            </h2>
+            <p role="status" className="text-sm text-brand-ink/70">{sent.message}</p>
+            <ul className="w-full list-disc space-y-1 pl-5 text-left text-sm text-brand-ink/60">
+              <li>Belum masuk? Coba cek folder spam atau promosi.</li>
+              <li>Akunmu tidak punya email? Minta bantuan gurumu untuk mengatur ulang.</li>
+            </ul>
+          </div>
+
+          {USE_MOCK && sent.devResetPath && (
+            <div className="rounded-2xl border-2 border-dashed border-brand-purple/30 bg-brand-purple/5 p-3 text-xs">
+              <p className="font-display font-extrabold text-brand-purple">Mode demo</p>
+              <p className="mt-1 text-brand-ink/70">
+                Email tidak benar-benar terkirim.{" "}
+                <Link to={sent.devResetPath} className="font-bold text-brand-purple underline">
+                  Buka tautan reset
+                </Link>
+              </p>
+            </div>
+          )}
+
+          {resendError && (
+            <div role="alert" className="rounded-2xl border-2 border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-600">
+              {resendError}
+            </div>
+          )}
+
+          <Button
+            type="button"
+            variant="outline"
+            fullWidth
+            disabled={cooldown > 0}
+            isLoading={forgot.isPending}
+            onClick={resend}
+          >
+            {cooldown > 0 ? `Kirim ulang dalam ${cooldown} detik` : "Kirim ulang tautan"}
+          </Button>
+          <button
+            type="button"
+            onClick={() => setSent(null)}
+            className="self-center rounded-lg font-body text-sm font-bold text-brand-purple hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue"
+          >
+            Salah ketik? Ganti username atau email
+          </button>
+        </div>
+      ) : (
+        <ForgotPasswordForm onSubmit={handleSubmit} />
+      )}
+    </AuthLayout>
+  );
+}
+
+export default ForgotPasswordPage;
