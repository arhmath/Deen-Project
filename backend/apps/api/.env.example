# ───────── App ─────────
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ───────── Auth ─────────
# Minimal 32 karakter acak. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# ───────── Firebase (Firestore) ─────────
# Opsi A — service account (isi ketiganya). Private key: ganti newline asli dengan \n
FIREBASE_PROJECT_ID=
# Nama bucket Firebase Storage, misalnya nama-project.firebasestorage.app atau nama-project.appspot.com
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Opsi B — emulator lokal (tanpa kredensial):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ───────── AI ─────────
# anthropic | openai (juga untuk endpoint OpenAI-compatible) | local (tanpa LLM, jawaban dari knowledge base)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
# Hanya untuk provider openai-compatible, contoh: https://api.openai.com/v1
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_RAG_TOP_K=5
# Ambang skor retrieval RAG (0–1)
AI_RAG_MIN_SCORE=0.70
AI_MAX_RECENT_MESSAGES=12
AI_MAX_SUMMARY_TOKENS=800
