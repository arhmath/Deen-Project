{
  "name": "deen-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
  "dev": "dotenv -e ./apps/api/.env -- next dev -p 3001",
  "build": "dotenv -e ./apps/api/.env -- next build",
  "start": "dotenv -e ./apps/api/.env -- next start -p 3001",
  "test": "vitest run",
  "seed": "tsx --env-file=apps/api/.env scripts/seed.ts",
  "smoke": "tsx --env-file=apps/api/.env scripts/smoke.ts",
  "typecheck": "tsc --noEmit",
  "seed:knowledge": "tsx scripts/seed-knowledge.ts"
},
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.12",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "vitest": "^5.0.4"
  }
}
