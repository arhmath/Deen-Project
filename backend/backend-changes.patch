+/**
+ * Fungsi murni untuk lapisan kompatibilitas FE↔BE (kontrak frontend: types/content.ts, types/courseAdmin.ts).
+ * Tidak menyentuh database → mudah diuji.
+ */
+import type { ContentDoc } from "../courses/course.types";
+import type { QuestionDoc } from "../quiz/quiz.logic";
+
+export type FeContentType = "LESSON" | "QUIZ" | "FLASHCARD" | "CHALLENGE" | "VIDEO";
+/** Tipe yang bisa diedit di editor guru FE. */
+export const EDITABLE_TYPES = ["LESSON", "FLASHCARD", "QUIZ"] as const;
+export type EditableType = (typeof EDITABLE_TYPES)[number];
+export const isEditable = (t: string): t is EditableType => (EDITABLE_TYPES as readonly string[]).includes(t);
+
+/** ARTICLE (hanya ada di BE) ditampilkan sebagai LESSON di FE. */
+export const feType = (t: ContentDoc["type"]): FeContentType => (t === "ARTICLE" ? "LESSON" : t);
+
+export interface Section { heading?: string; text: string }
+export interface Card { id: string; front: string; back: string }
+
+const str = (v: unknown) => (typeof v === "string" ? v : "");
+
+/** Isi pelajaran: `body.sections` (FE) atau `body.text` (seed/BE lama). */
+export function sectionsOf(body: Record<string, unknown>): Section[] {
+  if (Array.isArray(body.sections)) {
+    return body.sections
+      .filter((s): s is Record<string, unknown> => !!s && typeof s === "object")
+      .map((s) => ({ ...(str(s.heading).trim() ? { heading: str(s.heading) } : {}), text: str(s.text) }));
+  }
+  const t = str(body.text).trim();
+  return t ? [{ text: t }] : [];
+}
+
+export function cardsOf(body: Record<string, unknown>): Card[] {
+  if (!Array.isArray(body.cards)) return [];
+  return body.cards
+    .filter((c): c is Record<string, unknown> => !!c && typeof c === "object")
+    .map((c, i) => ({ id: str(c.id) || `k${i + 1}`, front: str(c.front), back: str(c.back) }));
+}
+
+/* ---------------- id soal ---------------- */
+/** Dokumen soal di BE ber-id `${contentId}_${idDariFE}` (id soal FE hanya unik per materi). Soal seed tidak berprefiks. */
+export const feQuestionId = (contentId: string, docId: string) => (docId.startsWith(`${contentId}_`) ? docId.slice(contentId.length + 1) : docId);
+export function resolveQuestionDocId(contentId: string, feId: string, existingDocIds: ReadonlySet<string>) {
+  return existingDocIds.has(feId) ? feId : `${contentId}_${feId}`;
+}
+
+/* ---------------- RewardOutcome / QuizResult ---------------- */
+export interface SubmitResponse {
+  completed: boolean;
+  alreadyCompleted: boolean;
+  quiz: null | {
+    attemptId: string; percent: number; perfect: boolean; correctCount: number;
+    results: { questionId: string; correct: boolean; selectedOptionIds: string[]; correctOptionIds: string[]; explanation: string | null }[];
+  };
+  rewards: { source: string; label: string; xp: number; point: number }[];
+  reward: { xp: number; point: number };
+  gamification: unknown;
+  levelUp: { from: number; to: number; name: string } | null;
+  courseCompleted: boolean;
+}
+
+export function toOutcome(r: SubmitResponse) {
+  return {
+    alreadyRewarded: r.alreadyCompleted || r.rewards.length === 0,
+    grants: r.rewards.map(({ label, xp, point }) => ({ label, xp, point })),
+    totalXp: r.reward.xp,
+    totalPoint: r.reward.point,
+    levelUp: r.levelUp,
+    courseCompleted: r.courseCompleted,
+    gamification: r.gamification,
+  };
+}
+
+export function toQuizResult(args: {
+  feAttemptId: string; contentId: string; response: SubmitResponse; questions: ({ id: string } & QuestionDoc)[]; bestScore: number | null;
+}) {
+  const { response: r, questions, contentId } = args;
+  if (!r.quiz) throw new Error("Respons kuis kosong");
+  const byQ = new Map(r.quiz.results.map((x) => [x.questionId, x]));
+  const ordered = [...questions].sort((a, b) => a.orderIndex - b.orderIndex);
+  return {
+    attemptId: args.feAttemptId,
+    score: r.quiz.percent,
+    correct: r.quiz.correctCount,
+    total: ordered.length,
+    perfect: r.quiz.perfect,
+    bestScore: Math.max(args.bestScore ?? 0, r.quiz.percent),
+    questions: ordered.map((q) => {
+      const res = byQ.get(q.id);
+      const opts = [...q.options].sort((a, b) => a.orderIndex - b.orderIndex);
+      return {
+        questionId: feQuestionId(contentId, q.id),
+        text: q.text,
+        options: opts.map((o) => ({ id: o.id, text: o.text })),
+        selectedOptionId: res?.selectedOptionIds[0] ?? null,
+        correctOptionId: res?.correctOptionIds[0] ?? opts.find((o) => o.isCorrect)?.id ?? "",
+        isCorrect: res?.correct ?? false,
+        explanation: res?.explanation ?? q.explanation ?? "",
+      };
+    }),
+    outcome: toOutcome(r),
+  };
+}
+
+/* ---------------- dokumen course (editor guru) ---------------- */
+export interface FeQuestion { id: string; text: string; options: { id: string; text: string }[]; correctOptionId: string; explanation: string }
+export interface FeContent { id: string; title: string; type: EditableType; sections: Section[]; cards: Card[]; questions: FeQuestion[] }
+export interface FeModule { id: string; title: string; contents: FeContent[] }
+
+/** Daftar masalah isi course (sama dengan mock FE). `strict` = syarat PUBLISHED. */
+export function courseProblems(c: { title: string; modules: FeModule[] }, strict: boolean): string[] {
+  const out: string[] = [];
+  if (!c.title.trim()) out.push("Judul course belum diisi.");
+  if (strict && c.modules.reduce((a, m) => a + m.contents.length, 0) === 0) out.push("Tambahkan minimal satu materi sebelum dipublikasikan.");
+  c.modules.forEach((m, mi) => {
+    if (!m.title.trim()) out.push(`Modul ${mi + 1}: judul belum diisi.`);
+    m.contents.forEach((ct) => {
+      const where = `Materi "${ct.title.trim() || "tanpa judul"}"`;
+      if (!ct.title.trim()) out.push(`Modul ${mi + 1}: ada materi yang judulnya belum diisi.`);
+      if (!strict) return;
+      if (ct.type === "LESSON") {
+        if (ct.sections.length === 0 || ct.sections.some((s) => !s.text.trim())) out.push(`${where}: isi pelajaran belum lengkap.`);
+      } else if (ct.type === "FLASHCARD") {
+        if (ct.cards.length === 0 || ct.cards.some((k) => !k.front.trim() || !k.back.trim())) out.push(`${where}: kartu belum lengkap (sisi depan dan belakang).`);
+      } else {
+        if (ct.questions.length === 0) out.push(`${where}: tambahkan minimal satu soal.`);
+        ct.questions.forEach((q, qi) => {
+          const filled = q.options.filter((o) => o.text.trim());
+          if (!q.text.trim()) out.push(`${where}: soal ${qi + 1} belum ada pertanyaannya.`);
+          else if (filled.length < 2) out.push(`${where}: soal ${qi + 1} butuh minimal 2 pilihan jawaban.`);
+          else if (!filled.some((o) => o.id === q.correctOptionId)) out.push(`${where}: soal ${qi + 1} belum punya jawaban yang benar.`);
+        });
+      }
+    });
+  });
+  return out;
+}
+
+/** Rapikan isi materi (trim, buang pilihan kosong) — sama dengan normalizeContent di mock FE. */
+export function normalizeContent(ct: FeContent): FeContent {
+  return {
+    id: ct.id,
+    title: ct.title.trim(),
+    type: ct.type,
+    sections: ct.type === "LESSON" ? ct.sections.map((s) => ({ ...(s.heading?.trim() ? { heading: s.heading.trim() } : {}), text: s.text })) : [],
+    cards: ct.type === "FLASHCARD" ? ct.cards.map((k) => ({ id: k.id, front: k.front.trim(), back: k.back.trim() })) : [],
+    questions:
+      ct.type === "QUIZ"
+        ? ct.questions.map((q) => ({
+            id: q.id,
+            text: q.text.trim(),
+            options: q.options.filter((o) => o.text.trim()).map((o) => ({ id: o.id, text: o.text.trim() })),
+            correctOptionId: q.options.some((o) => o.id === q.correctOptionId && o.text.trim()) ? q.correctOptionId : "",
+            explanation: q.explanation.trim(),
+          }))
+        : [],
+  };
+}
+
+/** Bentuk soal di BE dari soal editor FE. */
+export function toQuestionDoc(contentId: string, q: FeQuestion, orderIndex: number): QuestionDoc {
+  return {
+    contentId, text: q.text, type: "SINGLE_CHOICE", explanation: q.explanation || null, points: 1, orderIndex,
+    options: q.options.map((o, j) => ({ id: o.id, text: o.text, isCorrect: o.id === q.correctOptionId, orderIndex: j })),
+  };
+}
+
+/** Tanda tangan isi soal — dipakai untuk mendeteksi perubahan (kuis yang sudah dikerjakan tidak boleh diubah soalnya). */
+export const questionSignature = (q: Pick<QuestionDoc, "text" | "explanation" | "options" | "orderIndex">) =>
+  JSON.stringify([q.orderIndex, q.text, q.explanation ?? null, [...q.options].sort((a, b) => a.orderIndex - b.orderIndex).map((o) => [o.id, o.text, o.isCorrect])]);
