+import { db, ts } from "@/lib/firebase";
+import { C } from "@/shared/collections";
+import { Errors } from "@/shared/errors";
+import { docId } from "@/shared/ids";
+import { uniqueRef } from "@/shared/unique";
+import { auditInTx } from "../audit/audit";
+import { buildStudentRows } from "../monitoring/student-rows";
+import { notifyInTx } from "../notifications/notification.service";
+import type { AuthUser, UserDoc } from "../users/user.types";
+
+export const parentCompat = {
+  /**
+   * POST /parent/students {code} → StudentProgress.
+   * Alur kontrak frontend: santri membagikan "Kode untuk orang tua"; orang tua memasukkannya → tautan langsung ACTIVE.
+   * (Alur pengajuan + persetujuan guru `POST /parent/links` tetap tersedia.) Keamanan: kode acak 6 karakter,
+   * rate limit per user di route, dan tautan hanya memberi akses BACA ke anak tersebut (BR-003).
+   */
+  async linkByCode(parent: AuthUser, rawCode: string) {
+    const code = rawCode.trim().toUpperCase();
+    const key = await uniqueRef("linkCode", code).get();
+    const studentId = key.data()?.userId as string | undefined;
+    const sSnap = studentId ? await db().collection(C.users).doc(studentId).get() : null;
+    const student = sSnap?.data() as UserDoc | undefined;
+    if (!studentId || !student || student.role !== "SANTRI" || !student.isActive || student.deletedAt) {
+      throw Errors.notFound("Kode anak");
+    }
+    const parentSnap = await db().collection(C.users).doc(parent.id).get();
+    const parentName = (parentSnap.data() as UserDoc | undefined)?.name ?? "Orang tua";
+
+    const ref = db().collection(C.parentStudents).doc(docId(parent.id, studentId));
+    const now = ts();
+    await db().runTransaction(async (tx) => {
+      const cur = (await tx.get(ref)).data() as { status?: string; createdAt?: unknown; relationship?: string | null } | undefined;
+      if (cur?.status === "ACTIVE") throw Errors.conflict("Anak ini sudah terhubung dengan akunmu.");
+      tx.set(ref, { parentId: parent.id, studentId, relationship: cur?.relationship ?? null, status: "ACTIVE", createdAt: cur?.createdAt ?? now, updatedAt: now });
+      notifyInTx(tx, {
+        userId: studentId, type: "SYSTEM", title: "Orang tua terhubung",
+        message: `${parentName} sekarang bisa memantau perkembanganmu.`, data: { parentId: parent.id },
+      });
+      auditInTx(tx, { actorId: parent.id, action: "PARENT_LINKED_BY_CODE", entityType: "parentStudent", entityId: ref.id });
+    });
+    const [row] = await buildStudentRows([studentId]);
+    return row!;
+  },
+};
