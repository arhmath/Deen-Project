+/**
+ * Adapter kontrak FRONTEND untuk guru (`/admin/rooms`, `/admin/courses`).
+ * Otorisasi tetap di service inti: assertRoomOwner / assertCourseOwner (BR-004).
+ */
+import { z } from "zod";
+import type { WriteBatch } from "firebase-admin/firestore";
+import { db, toIso, ts } from "@/lib/firebase";
+import { C } from "@/shared/collections";
+import { Errors } from "@/shared/errors";
+import { countOf, getByIds, queryIn } from "@/shared/firestore-utils";
+import { SAFE_ID, newId } from "@/shared/ids";
+import { auditInTx } from "../audit/audit";
+import { assertCourseOwner } from "../courses/course.access";
+import { courseService, fanOutNotification } from "../courses/course.service";
+import { loadStructure } from "../courses/course.structure";
+import type { ContentDoc, CourseDoc } from "../courses/course.types";
+import type { UserGamificationDoc } from "../gamification/gamification.types";
+import type { QuestionDoc } from "../quiz/quiz.logic";
+import { assertRoomOwner, loadRoom, ownedRoomIds } from "../rooms/room.access";
+import { roomService } from "../rooms/room.service";
+import type { RoomDoc, RoomMemberDoc } from "../rooms/room.types";
+import type { AuthUser, UserDoc } from "../users/user.types";
+import {
+  cardsOf, courseProblems, isEditable, normalizeContent, questionSignature, resolveQuestionDocId, sectionsOf, toQuestionDoc, feQuestionId,
+  type FeContent, type FeModule,
+} from "./compat.logic";
+
+/* ------------------------------ skema body ------------------------------ */
+const id = z.string().regex(SAFE_ID, "ID tidak valid");
+const contentSchema = z.object({
+  id,
+  title: z.string().max(200),
+  type: z.enum(["LESSON", "FLASHCARD", "QUIZ"]),
+  sections: z.array(z.object({ heading: z.string().max(200).optional(), text: z.string().max(20_000) })).max(100).default([]),
+  cards: z.array(z.object({ id, front: z.string().max(1000), back: z.string().max(1000) })).max(200).default([]),
+  questions: z
+    .array(z.object({
+      id,
+      text: z.string().max(2000),
+      options: z.array(z.object({ id, text: z.string().max(500) })).max(8),
+      correctOptionId: z.string().max(128),
+      explanation: z.string().max(2000).default(""),
+    }))
+    .max(100)
+    .default([]),
+});
+export const saveCourseSchema = z.object({
+  title: z.string().max(200).optional(),
+  description: z.string().max(5000).optional(),
+  status: z.enum(["DRAFT", "PUBLISHED", "ARCHIVED"]).optional(),
+  modules: z.array(z.object({ id, title: z.string().max(200), contents: z.array(contentSchema).max(100) })).max(50).optional(),
+}); // field lain (roomId, roomName, updatedAt, …) sengaja diabaikan — tidak pernah dipercaya dari klien
+export type SaveCourseInput = z.output<typeof saveCourseSchema>;
+
+export const roomPatchSchema = z
+  .object({ name: z.string().trim().min(3, "Nama room minimal 3 karakter").max(150).optional(), archived: z.boolean().optional() })
+  .strict()
+  .refine((v) => Object.keys(v).length > 0, { message: "Tidak ada data yang diubah" });
+export const createCourseBody = z
+  .object({ roomId: id, title: z.string().trim().min(3, "Judul course minimal 3 karakter").max(200), description: z.string().trim().max(5000).optional() })
+  .strict();
+
+/* ------------------------------ ringkasan ------------------------------ */
+async function courseCounts(courseId: string) {
+  const [moduleCount, contentCount] = await Promise.all([
+    countOf(db().collection(C.courseModules).where("courseId", "==", courseId)),
+    countOf(db().collection(C.contents).where("courseId", "==", courseId)),
+  ]);
+  return { moduleCount, contentCount };
+}
+
+async function courseSummaries(admin: AuthUser, roomId?: string) {
+  const list = await courseService.list(admin, roomId ? { roomId } : {});
+  return Promise.all(list.map(async (c) => ({
+    id: c.id, title: c.title, roomId: c.roomId, roomName: c.roomName, status: c.status, ...(await courseCounts(c.id)),
+  })));
+}
+
+const roomSummary = (rid: string, r: RoomDoc, courseCount: number) => ({
+  id: rid, name: r.name, joinCode: r.joinCode, memberCount: r.memberCount, courseCount,
+  archived: r.status === "ARCHIVED", createdAt: toIso(r.createdAt) ?? new Date().toISOString(),
+});
+
+async function courseCountByRoom(adminId: string) {
+  const snap = await db().collection(C.courses).where("creatorId", "==", adminId).get();
+  const m = new Map<string, number>();
+  for (const d of snap.docs) {
+    const c = d.data() as CourseDoc;
+    if (c.deletedAt || c.status === "ARCHIVED") continue;
+    m.set(c.roomId, (m.get(c.roomId) ?? 0) + 1);
+  }
+  return m;
+}
+
+async function hasProgress(contentIds: string[]): Promise<boolean> {
+  for (const cid of contentIds) {
+    if (!(await db().collection(C.contentProgress).where("contentId", "==", cid).limit(1).get()).empty) return true;
+  }
+  return false;
+}
+
+/** Kumpulkan operasi tulis lalu commit per ≤400 operasi (batas Firestore 500). Validasi selesai SEBELUM menulis. */
+class Writes {
+  private ops: ((b: WriteBatch) => void)[] = [];
+  add(op: (b: WriteBatch) => void) { this.ops.push(op); }
+  async commit() {
+    for (let i = 0; i < this.ops.length; i += 400) {
+      const b = db().batch();
+      this.ops.slice(i, i + 400).forEach((op) => op(b));
+      await b.commit();
+    }
+  }
+}
+
+/* ------------------------------ dokumen course ------------------------------ */
+async function loadQuestionsOf(contentIds: string[]) {
+  const rows = await queryIn<QuestionDoc>((v) => db().collection(C.questions).where("contentId", "in", v), contentIds);
+  const by = new Map<string, ({ id: string } & QuestionDoc)[]>();
+  for (const r of rows) by.set(r.data.contentId, [...(by.get(r.data.contentId) ?? []), { id: r.id, ...r.data }]);
+  for (const list of by.values()) list.sort((a, b) => a.orderIndex - b.orderIndex);
+  return by;
+}
+
+export async function getCourseDoc(admin: AuthUser, courseId: string) {
+  const course = await assertCourseOwner(admin, courseId);
+  const room = await loadRoom(course.roomId).catch(() => null);
+  const { modules, contents } = await loadStructure(courseId, { publishedOnly: false });
+  const editable = contents.filter((c) => isEditable(c.type));
+  const qs = await loadQuestionsOf(editable.filter((c) => c.type === "QUIZ").map((c) => c.id));
+  return {
+    id: course.id, roomId: course.roomId, roomName: room?.name ?? "-", title: course.title, description: course.description ?? "",
+    status: course.status, updatedAt: toIso(course.updatedAt) ?? new Date().toISOString(),
+    modules: modules.map((m) => ({
+      id: m.id, title: m.title,
+      contents: editable.filter((c) => c.moduleId === m.id).map((c) => ({
+        id: c.id, title: c.title, type: c.type as FeContent["type"],
+        sections: c.type === "LESSON" ? sectionsOf(c.body) : [],
+        cards: c.type === "FLASHCARD" ? cardsOf(c.body) : [],
+        questions: c.type === "QUIZ"
+          ? (qs.get(c.id) ?? []).map((q) => ({
+              id: feQuestionId(c.id, q.id), text: q.text,
+              options: [...q.options].sort((a, b) => a.orderIndex - b.orderIndex).map((o) => ({ id: o.id, text: o.text })),
+              correctOptionId: q.options.find((o) => o.isCorrect)?.id ?? "", explanation: q.explanation ?? "",
+            }))
+          : [],
+      })),
+    })),
+  };
+}
+
+export const adminCompat = {
+  /* ---------------- room ---------------- */
+  async rooms(admin: AuthUser) {
+    const ids = await ownedRoomIds(admin.id, true);
+    const [rooms, counts] = await Promise.all([getByIds<RoomDoc>(C.rooms, ids), courseCountByRoom(admin.id)]);
+    return rooms
+      .filter((r) => !r.data.deletedAt)
+      .map((r) => roomSummary(r.id, r.data, counts.get(r.id) ?? 0))
+      .sort((a, b) => b.createdAt.localeCompare(a.createdAt));
+  },
+
+  async createRoom(admin: AuthUser, input: { name: string; description?: string }) {
+    const r = await roomService.create(admin, input);
+    return roomSummary(r.id, (await loadRoom(r.id)), 0);
+  },
+
+  async room(admin: AuthUser, roomId: string) {
+    const room = await assertRoomOwner(admin, roomId);
+    const snap = await db().collection(C.roomMembers).where("roomId", "==", roomId).where("isActive", "==", true).get();
+    const memberDocs = snap.docs.map((d) => d.data() as RoomMemberDoc);
+    const ids = memberDocs.map((m) => m.userId);
+    const [users, gams, courses] = await Promise.all([
+      getByIds<UserDoc>(C.users, ids), getByIds<UserGamificationDoc>(C.userGamification, ids), courseSummaries(admin, roomId),
+    ]);
+    const g = new Map(gams.map((x) => [x.id, x.data]));
+    const joined = new Map(memberDocs.map((m) => [m.userId, toIso(m.joinedAt)!]));
+    return {
+      room: roomSummary(roomId, room, courses.filter((c) => c.status !== "ARCHIVED").length),
+      members: users.filter((u) => !u.data.deletedAt).map((u) => ({
+        studentId: u.id, name: u.data.name, username: u.data.username,
+        level: g.get(u.id)?.level ?? 1, xp: g.get(u.id)?.totalXp ?? 0,
+        joinedAt: joined.get(u.id)!, lastActiveAt: toIso(g.get(u.id)?.lastActiveAt) ?? joined.get(u.id)!,
+      })).sort((a, b) => a.name.localeCompare(b.name)),
+      courses,
+    };
+  },
+
+  async updateRoom(admin: AuthUser, roomId: string, patch: z.output<typeof roomPatchSchema>) {
+    await assertRoomOwner(admin, roomId);
+    const upd: Record<string, any> = { updatedAt: ts() }; // eslint-disable-line @typescript-eslint/no-explicit-any
+    if (patch.name !== undefined) upd.name = patch.name;
+    if (patch.archived !== undefined) upd.status = patch.archived ? "ARCHIVED" : "ACTIVE";
+    await db().runTransaction(async (tx) => {
+      tx.update(db().collection(C.rooms).doc(roomId), upd);
+      if (patch.archived !== undefined) {
+        auditInTx(tx, { actorId: admin.id, action: patch.archived ? "ROOM_ARCHIVED" : "ROOM_UNARCHIVED", entityType: "room", entityId: roomId });
+      }
+    });
+    const counts = await courseCountByRoom(admin.id);
+    return roomSummary(roomId, await loadRoom(roomId), counts.get(roomId) ?? 0);
+  },
+
+  removeMember: (admin: AuthUser, roomId: string, studentId: string) => roomService.removeMember(admin, roomId, studentId),
+
+  /* ---------------- course ---------------- */
+  courses: (admin: AuthUser) => courseSummaries(admin),
+
+  async createCourse(admin: AuthUser, input: z.output<typeof createCourseBody>) {
+    const c = await courseService.create(admin, input);
+    await courseService.createModule(admin, c.id, { title: "Modul 1" }); // course baru selalu DRAFT dengan satu modul kosong
+    return getCourseDoc(admin, c.id);
+  },
+
+  course: getCourseDoc,
+
+  /**
+   * PUT /admin/courses/:id — simpan SELURUH dokumen editor. Disinkronkan ke koleksi courseModules/contents/questions.
+   * Aturan: hanya pemilik; id modul/materi tidak boleh bentrok dengan course lain; materi/modul yang sudah dikerjakan santri
+   * tidak boleh dihapus; soal kuis yang sudah dikerjakan tidak boleh diubah; PUBLISHED butuh isi lengkap.
+   */
+  async saveCourse(admin: AuthUser, courseId: string, input: SaveCourseInput) {
+    const course = await assertCourseOwner(admin, courseId);
+    if (course.status === "ARCHIVED") throw Errors.conflict("Course yang diarsipkan tidak bisa diubah.");
+    const title = (input.title ?? course.title).trim();
+    const description = (input.description ?? course.description ?? "").trim();
+    const status = input.status ?? course.status;
+
+    const existing = await loadStructure(courseId, { publishedOnly: false });
+    const modulesIn: FeModule[] = (input.modules ?? (await getCourseDoc(admin, courseId)).modules).map((m) => ({
+      id: m.id, title: m.title.trim(), contents: m.contents.map((c) => normalizeContent(c as FeContent)),
+    }));
+
+    const problems = courseProblems({ title, modules: modulesIn }, status === "PUBLISHED");
+    if (problems.length) {
+      throw Errors.validation(
+        { course: problems[0]! },
+        status === "PUBLISHED" ? `Course belum bisa dipublikasikan:\n${problems.join("\n")}` : problems.join("\n")
+      );
+    }
+
+    /* ---- validasi id ---- */
+    const exMod = new Map(existing.modules.map((m) => [m.id, m]));
+    const exCon = new Map(existing.contents.map((c) => [c.id, c]));
+    const seen = new Set<string>();
+    for (const m of modulesIn) {
+      for (const key of [m.id, ...m.contents.map((c) => c.id)]) {
+        if (seen.has(key)) throw Errors.conflict("ID modul/materi bentrok. Muat ulang halaman lalu coba lagi.");
+        seen.add(key);
+      }
+    }
+    const newMods = modulesIn.filter((m) => !exMod.has(m.id));
+    const newCons = modulesIn.flatMap((m) => m.contents).filter((c) => !exCon.has(c.id));
+    const taken = await Promise.all([
+      ...newMods.map((m) => db().collection(C.courseModules).doc(m.id).get()),
+      ...newCons.map((c) => db().collection(C.contents).doc(c.id).get()),
+    ]);
+    if (taken.some((s) => s.exists)) throw Errors.conflict("ID modul/materi bentrok. Muat ulang halaman lalu coba lagi.");
+
+    /* ---- yang dihapus ---- */
+    const keepContentIds = new Set(modulesIn.flatMap((m) => m.contents.map((c) => c.id)));
+    const keepModuleIds = new Set(modulesIn.map((m) => m.id));
+    const removedContents = existing.contents.filter((c) => isEditable(c.type) && !keepContentIds.has(c.id));
+    const removedModules = existing.modules.filter((m) => !keepModuleIds.has(m.id));
+    for (const m of removedModules) {
+      if (existing.contents.some((c) => c.moduleId === m.id && !removedContents.includes(c) )) {
+        throw Errors.conflict("Modul ini berisi materi yang tidak bisa dihapus dari editor.");
+      }
+    }
+    if (removedContents.length && (await hasProgress(removedContents.map((c) => c.id)))) {
+      throw Errors.conflict("Ada materi yang sudah dikerjakan santri, jadi tidak bisa dihapus. Arsipkan course sebagai gantinya.");
+    }
+
+    /* ---- soal kuis ---- */
+    const quizIds = modulesIn.flatMap((m) => m.contents).filter((c) => c.type === "QUIZ").map((c) => c.id);
+    const exQs = await loadQuestionsOf([...new Set([...quizIds, ...removedContents.map((c) => c.id)])]);
+    const writes = new Writes();
+    const now = ts();
+
+    for (const [mi, m] of modulesIn.entries()) {
+      const ex = exMod.get(m.id);
+      writes.add((b) => ex
+        ? b.update(db().collection(C.courseModules).doc(m.id), { title: m.title, orderIndex: mi, updatedAt: now })
+        : b.create(db().collection(C.courseModules).doc(m.id), { courseId, title: m.title, description: null, orderIndex: mi, createdAt: now, updatedAt: now }));
+
+      for (const [ci, c] of m.contents.entries()) {
+        const old = exCon.get(c.id);
+        if (old && old.type !== c.type && (await hasProgress([c.id]))) {
+          throw Errors.conflict(`Tipe materi "${c.title}" tidak bisa diubah karena sudah dikerjakan santri.`);
+        }
+        const { text: _legacy, sections: _s, cards: _k, ...rest } = (old?.body ?? {}) as Record<string, unknown>;
+        void _legacy; void _s; void _k;
+        const body: Record<string, unknown> =
+          c.type === "LESSON" ? { ...rest, sections: c.sections } : c.type === "FLASHCARD" ? { ...rest, cards: c.cards } : { ...rest };
+        writes.add((b) => old
+          ? b.update(db().collection(C.contents).doc(c.id), { moduleId: m.id, type: c.type, title: c.title, body, orderIndex: ci, updatedAt: now })
+          : b.create(db().collection(C.contents).doc(c.id), {
+              moduleId: m.id, courseId, type: c.type, title: c.title, description: null, body, xpReward: 0, pointReward: 0,
+              orderIndex: ci, isPublished: true, createdAt: now, updatedAt: now,
+            } satisfies ContentDoc));
+
+        if (c.type === "QUIZ") {
