+const envMock = vi.hoisted(() => ({ cur: {} as Record<string, unknown> }));
+vi.mock("@/config/env", () => ({ env: () => envMock.cur }));
+
+import { getProvider } from "@/ai/providers";
+
+const req = { system: "SISTEM", messages: [{ role: "user" as const, content: "Halo" }], maxTokens: 300, timeoutMs: 2000, context: { chunks: [], tools: [], domain: "DEEN_FEATURE" as const, userMessage: "Halo" } };
+const fetchMock = vi.fn();
+beforeEach(() => { vi.stubGlobal("fetch", fetchMock); fetchMock.mockReset(); });
+afterEach(() => vi.unstubAllGlobals());
+
+describe("provider LLM", () => {
+  it("tanpa AI_API_KEY atau provider=local → provider local (tidak memanggil jaringan)", async () => {
+    envMock.cur = { AI_PROVIDER: "anthropic", AI_API_KEY: undefined };
+    expect(getProvider().name).toBe("local");
+    envMock.cur = { AI_PROVIDER: "local", AI_API_KEY: "k" };
+    expect(getProvider().name).toBe("local");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("anthropic: endpoint, header, body, dan parsing blok teks", async () => {
+    envMock.cur = { AI_PROVIDER: "anthropic", AI_API_KEY: "sk-test", AI_MODEL: undefined, AI_BASE_URL: undefined };
+    fetchMock.mockResolvedValue(new Response(JSON.stringify({ content: [{ type: "text", text: "Halo " }, { type: "tool_use" }, { type: "text", text: "dunia" }] }), { status: 200 }));
+    const out = await getProvider().generateReply(req);
+    expect(out).toBe("Halo dunia");
+    const [url, init] = fetchMock.mock.calls[0]!;
+    expect(url).toBe("https://api.anthropic.com/v1/messages");
+    expect(init.headers).toMatchObject({ "x-api-key": "sk-test", "anthropic-version": "2023-06-01" });
+    expect(JSON.parse(init.body)).toMatchObject({ model: "claude-haiku-5-5", max_tokens: 300, system: "SISTEM", messages: [{ role: "user", content: "Halo" }] });
+  });
+
+  it("openai-compatible: base URL & model kustom", async () => {
+    envMock.cur = { AI_PROVIDER: "openai", AI_API_KEY: "k", AI_MODEL: "model-x", AI_BASE_URL: "http://localhost:11434/v1" };
+    fetchMock.mockResolvedValue(new Response(JSON.stringify({ choices: [{ message: { content: " Jawaban " } }] }), { status: 200 }));
+    expect(await getProvider().generateReply(req)).toBe("Jawaban");
+    expect(fetchMock.mock.calls[0]![0]).toBe("http://localhost:11434/v1/chat/completions");
+    expect(JSON.parse(fetchMock.mock.calls[0]![1].body)).toMatchObject({ model: "model-x", messages: [{ role: "system", content: "SISTEM" }, { role: "user" }] });
+  });
+
+  it("error provider (401/500/jaringan) → 503 pesan aman, kunci & detail tidak bocor", async () => {
+    envMock.cur = { AI_PROVIDER: "anthropic", AI_API_KEY: "sk-rahasia" };
+    fetchMock.mockResolvedValue(new Response(JSON.stringify({ error: { message: "invalid x-api-key sk-rahasia" } }), { status: 401 }));
+    await expect(getProvider().generateReply(req)).rejects.toMatchObject({ status: 503, message: "Layanan AI sedang tidak tersedia. Silakan coba kembali." });
+    fetchMock.mockRejectedValue(new TypeError("fetch failed"));
+    const err = await getProvider().generateReply(req).catch((e) => e);
+    expect(err.status).toBe(503);
+    expect(JSON.stringify(err)).not.toContain("sk-rahasia");
+  });
+});
