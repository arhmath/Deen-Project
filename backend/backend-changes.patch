+/**
+ * Firestore tiruan di memori — cukup untuk menjalankan service Deen (get/set/create/update/delete, where ==/in/array-contains,
+ * count, batch, transaksi, FieldValue.increment/arrayUnion/arrayRemove). BUKAN pengganti emulator: tidak ada isolasi transaksi
+ * dan tidak ada pengurutan orderBy. Dipakai agar alur bisnis (reward idempotent, kepemilikan, dst.) teruji tanpa kredensial.
+ */
+import { Timestamp } from "firebase-admin/firestore";
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+type Data = Record<string, any>;
+const store = new Map<string, Map<string, Data>>();
+export const resetFake = () => store.clear();
+export const peek = (col: string, id: string): Data | undefined => store.get(col)?.get(id);
+
+export const FieldValue = {
+  increment: (n: number) => ({ __op: "inc", n }),
+  arrayUnion: (...v: unknown[]) => ({ __op: "union", v }),
+  arrayRemove: (...v: unknown[]) => ({ __op: "remove", v }),
+};
+export { Timestamp };
+export const ts = (d: Date = new Date()) => Timestamp.fromDate(d);
+export const toIso = (v: any) => (v ? (v instanceof Date ? v : v.toDate()).toISOString() : null);
+
+function clone(v: any): any {
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Timestamp || v instanceof Date) return v;
+  if (Array.isArray(v)) return v.map(clone);
+  const o: Data = {};
+  for (const k of Object.keys(v)) if (v[k] !== undefined) o[k] = clone(v[k]);
+  return o;
+}
+function apply(cur: Data, patch: Data): Data {
+  const out = { ...cur };
+  for (const [k, val] of Object.entries(patch)) {
+    if (val && typeof val === "object" && "__op" in val) {
+      const prev = out[k];
+      if (val.__op === "inc") out[k] = (prev ?? 0) + val.n;
+      else if (val.__op === "union") out[k] = [...new Set([...(prev ?? []), ...val.v])];
+      else out[k] = (prev ?? []).filter((x: unknown) => !val.v.includes(x));
+    } else if (val !== undefined) out[k] = clone(val);
+  }
+  return out;
+}
+const dupErr = () => Object.assign(new Error("ALREADY_EXISTS"), { code: 6 });
+const nfErr = () => Object.assign(new Error("NOT_FOUND"), { code: 5 });
+
+class Snap {
+  exists: boolean;
+  id: string;
+  constructor(public ref: DocRef, private d?: Data) { this.exists = d !== undefined; this.id = ref.id; }
+  data() { return this.d ? clone(this.d) : undefined; }
+}
+class DocRef {
+  constructor(public col: string, public id: string) {}
+  get path() { return `${this.col}/${this.id}`; }
+  async get() { return new Snap(this, store.get(this.col)?.get(this.id)); }
+  async set(data: Data, opts?: { merge?: boolean }) { this.write("set", data, opts); }
+  async create(data: Data) { this.write("create", data); }
+  async update(patch: Data) { this.write("update", patch); }
+  async delete() { store.get(this.col)?.delete(this.id); }
+  write(kind: "set" | "create" | "update", data: Data, opts?: { merge?: boolean }) {
+    const m = store.get(this.col) ?? store.set(this.col, new Map()).get(this.col)!;
+    const cur = m.get(this.id);
+    if (kind === "create" && cur) throw dupErr();
+    if (kind === "update" && !cur) throw nfErr();
+    m.set(this.id, kind === "update" || opts?.merge ? apply(cur ?? {}, data) : apply({}, data));
+  }
+}
+interface Filter { f: string; op: string; v: any }
+class Query {
+  constructor(protected col: string, protected filters: Filter[] = [], protected lim?: number) {}
+  where(f: string, op: string, v: any) { return new Query(this.col, [...this.filters, { f, op, v }], this.lim); }
+  orderBy() { return this; }
+  limit(n: number) { return new Query(this.col, this.filters, n); }
+  offset() { return this; }
+  private rows() {
+    const m = store.get(this.col) ?? new Map<string, Data>();
+    let rows = [...m.entries()].filter(([, d]) =>
+      this.filters.every(({ f, op, v }) => {
+        const x = d[f];
+        if (op === "==") return x === v;
+        if (op === "in") return (v as unknown[]).includes(x);
+        if (op === "array-contains") return Array.isArray(x) && x.includes(v);
+        throw new Error(`fake-firestore: operator ${op} belum didukung`);
+      })
+    );
+    if (this.lim !== undefined) rows = rows.slice(0, this.lim);
+    return rows;
+  }
+  async get() {
+    const docs = this.rows().map(([id, d]) => ({ id, ref: new DocRef(this.col, id), exists: true, data: () => clone(d) }));
+    return { docs, empty: docs.length === 0, size: docs.length, forEach: (fn: (d: unknown) => void) => docs.forEach(fn) };
+  }
+  count() { return { get: async () => ({ data: () => ({ count: this.rows().length }) }) }; }
+}
+class Coll extends Query {
+  constructor(col: string) { super(col); }
+  doc(id?: string) { return new DocRef(this.col, id ?? crypto.randomUUID()); }
+}
+
+class Batch {
+  private ops: (() => void)[] = [];
+  set(r: DocRef, d: Data, o?: { merge?: boolean }) { this.ops.push(() => r.write("set", d, o)); return this; }
+  create(r: DocRef, d: Data) { this.ops.push(() => r.write("create", d)); return this; }
+  update(r: DocRef, d: Data) { this.ops.push(() => r.write("update", d)); return this; }
+  delete(r: DocRef) { this.ops.push(() => void store.get(r.col)?.delete(r.id)); return this; }
+  async commit() { this.ops.forEach((o) => o()); }
+}
+class Tx extends Batch {
+  async get(r: DocRef | Query) { return r instanceof DocRef ? r.get() : (r as Query).get(); }
+  async getAll(...refs: DocRef[]) { return Promise.all(refs.map((r) => r.get())); }
+  // tulis langsung (tanpa isolasi) — cukup untuk alur uji satu thread
+  override set(r: DocRef, d: Data, o?: { merge?: boolean }) { r.write("set", d, o); return this; }
+  override create(r: DocRef, d: Data) { r.write("create", d); return this; }
+  override update(r: DocRef, d: Data) { r.write("update", d); return this; }
+  override delete(r: DocRef) { store.get(r.col)?.delete(r.id); return this; }
+}
+
+const fake = {
+  collection: (name: string) => new Coll(name),
+  batch: () => new Batch(),
+  getAll: async (...refs: DocRef[]) => Promise.all(refs.map((r) => r.get())),
+  runTransaction: async <T>(fn: (tx: Tx) => Promise<T>) => fn(new Tx()),
+  settings: () => undefined,
+};
+export const db = () => fake;
