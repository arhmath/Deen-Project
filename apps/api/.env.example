# ───────── App ─────────
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ───────── Auth ─────────
# Minimal 32 karakter acak. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
# Masa berlaku tautan reset password (menit)
PASSWORD_RESET_TTL_MIN=30

# ───────── Email (lupa password) ─────────
# URL frontend untuk membentuk tautan di email, mis. https://deen.id
APP_URL=http://localhost:5173
# Gmail SMTP: host=smtp.gmail.com, port=587, user=alamat Gmail lengkap,
# pass=Google App Password 16 karakter (BUKAN password login Gmail).
# Aktifkan Verifikasi 2 Langkah Google lalu buat App Password:
# https://myaccount.google.com/apppasswords
# MAIL_FROM sebaiknya menggunakan alamat yang sama dengan SMTP_USER untuk Gmail SMTP.
# Kosongkan SMTP_HOST saat development → email TIDAK dikirim; tautan hanya dicatat di log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Deen <no-reply@deen.app>

# ───────── Firebase (Firestore) ─────────
# Opsi A — service account (isi ketiganya). Private key: ganti newline asli dengan \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ───────── Cloudinary (avatar profil) ─────────
# Ambil dari Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opsi B — emulator lokal (tanpa kredensial):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ───────── AI ─────────
# anthropic | openai (juga untuk endpoint OpenAI-compatible) | local (tanpa LLM, jawaban dari knowledge base)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
# Hanya untuk provider openai-compatible, contoh: https://api.openai.com/v1
# Gemini: AI_PROVIDER=openai, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-3.5-flash-lite
# File ini dibaca dari backend/apps/api/.env (BUKAN .env di root, itu khusus frontend Vite). Restart server setelah mengubahnya.
AI_BASE_URL=
AI_TIMEOUT_MS=30000
# Batas token keluaran (default 700). Naikkan ke 2000+ bila AI_REASONING_EFFORT diaktifkan.
AI_MAX_TOKENS=700
# Batas token LLM per user per hari (prompt + jawaban). 0 = tanpa batas.
AI_DAILY_TOKEN_LIMIT=20000
# Opsional: minimal | low | medium | high (kosongkan = tidak dikirim). Hanya untuk endpoint yang mendukung.
AI_REASONING_EFFORT=
AI_RAG_TOP_K=5
# Ambang skor retrieval RAG (0–1)
AI_RAG_MIN_SCORE=0.70
AI_MAX_RECENT_MESSAGES=12
AI_MAX_SUMMARY_TOKENS=800
