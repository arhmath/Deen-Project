rules_version = '2';
// Semua akses data HANYA lewat backend (Admin SDK, yang mem-bypass rules).
// Klien (browser) tidak boleh membaca/menulis Firestore secara langsung.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
